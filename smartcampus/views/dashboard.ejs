<%- include('partials/header') %>
<div class="head">
  <h1>Tableau de bord</h1>
  <nav class="filters">
    <% [['semaine','7 jours'],['mois','30 jours'],['semestre','Semestre']].forEach(([v, l]) => { %>
      <a class="<%= periode === v ? 'active' : '' %>" href="/admin/dashboard?periode=<%= v %>"><%= l %></a>
    <% }) %>
  </nav>
</div>
<% if (!kpi.total) { %>
  <p class="empty">Aucun incident sur la période.</p>
<% } else { %>
<div class="kpis">
  <div class="kpi"><span><%= kpi.total %></span>incidents</div>
  <div class="kpi"><span><%= kpi.delai_h === null ? '–' : String(kpi.delai_h).replace('.', ',') + ' h' %></span>délai moyen de résolution</div>
  <div class="kpi <%= kpi.en_retard ? 'warn' : '' %>"><span><%= kpi.en_retard %></span>en retard (&gt; 24 h)</div>
  <div class="kpi <%= kpi.securite ? 'crit' : '' %>"><span><%= kpi.securite %></span>incidents de sécurité</div>
</div>
<div class="charts">
  <section class="card"><h2>Par catégorie</h2><div class="chart-box"><canvas id="c-categorie"></canvas></div></section>
  <section class="card"><h2>Par statut</h2><div class="chart-box"><canvas id="c-statut"></canvas></div></section>
  <section class="card wide"><h2>Lieux les plus touchés</h2><div class="chart-box tall"><canvas id="c-lieu"></canvas></div></section>
</div>
<script src="/vendor/chart.js/chart.umd.js"></script>
<script>
  const data = <%- JSON.stringify(data).replace(/</g, '\\u003c') %>;
  const couleur = '#2563eb';
  const opts = (horizontal) => ({
    indexAxis: horizontal ? 'y' : 'x',
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: { [horizontal ? 'x' : 'y']: { beginAtZero: true, ticks: { precision: 0 } } },
  });
  const bar = (id, rows, horizontal, colors) => new Chart(document.getElementById(id), {
    type: 'bar',
    data: { labels: rows.map(r => r.label), datasets: [{ data: rows.map(r => r.n), backgroundColor: colors || couleur, borderRadius: 4 }] },
    options: opts(horizontal),
  });
  bar('c-categorie', data.categories, false);
  bar('c-statut', data.statuts, false, data.statuts.map(r => ({ 'Nouveau': '#f59e0b', 'En cours': '#2563eb', 'Résolu': '#16a34a' })[r.label]));
  bar('c-lieu', data.lieux, true);
</script>
<% } %>
<%- include('partials/footer') %>
