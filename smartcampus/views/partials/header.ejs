<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titre %> · SmartCampus AI</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <a class="logo" href="/">SmartCampus <span>AI</span></a>
  <% if (user) { %>
  <nav>
    <% if (user.role === 'etudiant') { %>
      <a href="/mes-demandes">Mes demandes</a>
      <a href="/tickets/nouveau">Signaler</a>
    <% } else if (user.role === 'technicien') { %>
      <a href="/file">Ma file</a>
    <% } else if (user.role === 'admin') { %>
      <a href="/admin/tickets">Tickets</a>
      <a href="/admin/dashboard">Tableau de bord</a>
    <% } %>
    <a href="/assistant">Assistant</a>
  </nav>
  <form method="post" action="/logout" class="who">
    <span><%= user.nom %> · <%= { etudiant: 'Étudiant', technicien: 'Technicien', admin: 'Admin' }[user.role] %></span>
    <button class="link">Déconnexion</button>
  </form>
  <% } %>
</header>
<main>
