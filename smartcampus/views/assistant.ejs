<%- include('partials/header') %>
<div class="assistant-layout">
  <section class="card chat chat-shell">
    <!-- En-tête du chat -->
    <header class="chat-header">
      <span class="avatar bot-avatar chat-header-avatar" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="26" height="26" role="img" aria-hidden="true" focusable="false">
          <rect x="9" y="16" width="30" height="22" rx="8" fill="#fff"/>
          <rect x="21" y="8" width="6" height="8" rx="3" fill="#fff"/>
          <circle cx="24" cy="7" r="3" fill="#fff"/>
          <circle cx="18" cy="26" r="3" fill="#2563eb"/>
          <circle cx="30" cy="26" r="3" fill="#2563eb"/>
          <path d="M18 32c2 2.4 4 3.5 6 3.5s4-1.1 6-3.5" fill="none" stroke="#2563eb" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M6 24v4M42 24v4" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
        </svg>
      </span>
      <div class="chat-header-info">
        <h1 class="chat-title">Assistant SmartCampus</h1>
        <p class="chat-status"><span class="status-dot" aria-hidden="true"></span>En ligne · répond en quelques secondes</p>
      </div>
      <span class="chat-badge">IA · Amazon Bedrock</span>
    </header>

    <div id="messages" class="messages" aria-live="polite"></div>

    <div id="suggestions" class="suggestions" aria-label="Questions suggérées">
      <button type="button" class="suggestion">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.8a15 15 0 0 1 20 0"/><circle cx="12" cy="20" r="1"/></svg>
        <span class="suggestion-text">Comment me connecter au Wi-Fi ?</span>
      </button>
      <button type="button" class="suggestion">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span class="suggestion-text">Horaires de la bibliothèque</span>
      </button>
      <button type="button" class="suggestion">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="4" y="9" width="16" height="8" rx="2"/><path d="M8 17h8v4H8z"/></svg>
        <span class="suggestion-text">Comment imprimer ?</span>
      </button>
      <button type="button" class="suggestion">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4h12l-2 4 2 4H4"/></svg>
        <span class="suggestion-text">Signaler un problème</span>
      </button>
    </div>

    <form id="chat-form" class="chat-form chat-bar">
      <input id="question" name="question" maxlength="500" placeholder="Écrivez votre message…" autocomplete="off" required>
      <button class="send-round" id="send-btn" aria-label="Envoyer" disabled>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
      </button>
    </form>
    <p class="chat-note">L'assistant répond à partir de la FAQ du campus et peut se tromper. Pour un problème, faites un signalement.</p>
  </section>

  <!-- Panneau latéral (masqué sur mobile) -->
  <aside class="chat-aside">
    <h2 class="aside-title">Ce que je peux faire</h2>
    <ul class="aside-list">
      <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.8a15 15 0 0 1 20 0"/><circle cx="12" cy="20" r="1"/></svg><span>Wi-Fi et réseau</span></li>
      <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Horaires</span></li>
      <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="4" y="9" width="16" height="8" rx="2"/><path d="M8 17h8v4H8z"/></svg><span>Impression</span></li>
      <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span>Réservations</span></li>
      <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4h12l-2 4 2 4H4"/></svg><span>Aide au signalement</span></li>
    </ul>
    <% if (user && user.role === 'etudiant') { %>
      <a class="button primary aside-cta" href="/tickets/nouveau">Signaler un problème</a>
    <% } %>
  </aside>
</div>

<!-- Avatar SVG de l'assistant (cloné en JS, jamais via innerHTML) -->
<template id="tpl-avatar">
  <span class="avatar bot-avatar" aria-hidden="true">
    <svg viewBox="0 0 48 48" width="24" height="24" role="img" aria-hidden="true" focusable="false">
      <rect x="9" y="16" width="30" height="22" rx="8" fill="#fff"/>
      <rect x="21" y="8" width="6" height="8" rx="3" fill="#fff"/>
      <circle cx="24" cy="7" r="3" fill="#fff"/>
      <circle cx="18" cy="26" r="3" fill="#2563eb"/>
      <circle cx="30" cy="26" r="3" fill="#2563eb"/>
      <path d="M18 32c2 2.4 4 3.5 6 3.5s4-1.1 6-3.5" fill="none" stroke="#2563eb" stroke-width="2.6" stroke-linecap="round"/>
      <path d="M6 24v4M42 24v4" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
    </svg>
  </span>
</template>

<script>
(function () {
  var PRENOM = <%- JSON.stringify(prenom || '') %>;
  var INITIALES = <%- JSON.stringify(initiales || '') %>;

  var form = document.getElementById('chat-form');
  var input = document.getElementById('question');
  var box = document.getElementById('messages');
  var sendBtn = document.getElementById('send-btn');
  var suggestions = document.getElementById('suggestions');
  var tplAvatar = document.getElementById('tpl-avatar');

  function heure() {
    var d = new Date();
    return d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');
  }

  function avatarBot() {
    return tplAvatar.content.firstElementChild.cloneNode(true);
  }
  function avatarUser() {
    var s = document.createElement('span');
    s.className = 'avatar user-avatar';
    s.setAttribute('aria-hidden', 'true');
    s.textContent = INITIALES || '•';
    return s;
  }

  // Construit une ligne de message (avatar + bulle + heure). Aucun innerHTML.
  function ajouter(classe, texte, lien) {
    var row = document.createElement('div');
    row.className = 'msg-row ' + (classe.indexOf('user') !== -1 ? 'from-user' : 'from-bot');

    if (classe.indexOf('user') !== -1) row.appendChild(avatarUser());
    else row.appendChild(avatarBot());

    var wrap = document.createElement('div');
    wrap.className = 'msg-wrap';

    var bulle = document.createElement('div');
    bulle.className = 'msg ' + classe;
    bulle.textContent = texte;

    if (lien) {
      var a = document.createElement('a');
      a.href = lien;
      a.className = 'button';
      a.textContent = 'Créer un signalement';
      bulle.appendChild(document.createElement('br'));
      bulle.appendChild(a);
    }
    wrap.appendChild(bulle);

    if (classe.indexOf('pending') === -1) {
      var h = document.createElement('span');
      h.className = 'msg-time';
      h.textContent = heure();
      wrap.appendChild(h);
    }
    row.appendChild(wrap);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
    return row;
  }

  // Indicateur « l'assistant écrit… » (trois points)
  function ajouterAttente() {
    var row = document.createElement('div');
    row.className = 'msg-row from-bot';
    row.appendChild(avatarBot());
    var bulle = document.createElement('div');
    bulle.className = 'msg bot typing';
    bulle.setAttribute('aria-label', "L'assistant écrit…");
    for (var i = 0; i < 3; i++) {
      var dot = document.createElement('span');
      dot.className = 'dot';
      bulle.appendChild(dot);
    }
    row.appendChild(bulle);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
    return row;
  }

  function majBouton() {
    // Bouton d'envoi désactivé tant que le champ est vide (sauf pendant l'attente)
    if (!input.disabled) sendBtn.disabled = input.value.trim() === '';
  }

  function verrouiller(actif) {
    input.disabled = actif;
    sendBtn.disabled = actif || input.value.trim() === '';
  }

  async function envoyer(question) {
    question = (question || '').trim();
    if (!question || input.disabled) return;
    if (suggestions) suggestions.hidden = true;
    ajouter('user', question);
    input.value = '';
    verrouiller(true);
    var attente = ajouterAttente();
    try {
      var r = await fetch('/api/assistant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: question }),
      });
      var d = await r.json();
      attente.remove();
      ajouter('bot', d.reponse || d.erreur || 'Erreur', d.signalement);
    } catch (e) {
      attente.remove();
      ajouter('bot', "L'assistant est indisponible pour le moment.");
    } finally {
      verrouiller(false);
      input.focus();
    }
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    envoyer(input.value);
  });

  input.addEventListener('input', majBouton);

  // Entrée pour envoyer (on évite le retour ligne)
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });

  if (suggestions) {
    suggestions.querySelectorAll('.suggestion').forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.querySelector('.suggestion-text');
        envoyer(t ? t.textContent : b.textContent);
      });
    });
  }

  // Message d'accueil automatique à l'ouverture
  ajouter('bot',
    'Bonjour ' + (PRENOM || '') + ' ! Je suis l\'assistant du campus. Je peux répondre à vos questions sur le Wi-Fi, les horaires, l\'impression, les réservations… et vous aider à signaler un problème.');
  majBouton();
})();
</script>
<%- include('partials/footer') %>
