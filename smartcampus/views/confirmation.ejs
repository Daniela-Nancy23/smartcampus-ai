<%- include('partials/header') %>
<section class="card narrow center">
  <h1>Signalement envoyé</h1>
  <p class="big"><%= ticket.numero %></p>
  <p>Statut : <span class="badge statut-nouveau">Nouveau</span></p>
  <% if (securite) { %><p class="alert error">Incident de sécurité : priorité critique, le responsable sécurité est alerté immédiatement. En cas de danger, appelez le 112.</p><% } %>
  <p><a class="button" href="/tickets/<%= ticket.id %>">Voir le suivi</a> <a class="button" href="/mes-demandes">Mes demandes</a></p>
</section>
<%- include('partials/footer') %>
