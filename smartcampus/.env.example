# --- Application ---
PORT=3000
# Chaîne aléatoire longue (ex. : openssl rand -hex 32)
JWT_SECRET=remplacer-par-une-chaine-aleatoire-longue

# --- Base RDS PostgreSQL ---
PGHOST=xxxx.yyyy.us-west-2.rds.amazonaws.com
PGPORT=5432
PGDATABASE=smartcampus
PGUSER=smartcampus
PGPASSWORD=remplacer
# RDS impose TLS : laisser à true sur AWS, false en local
PGSSL=true

# --- AWS (les droits viennent du rôle IAM de l'EC2 : aucune clé ici) ---
AWS_REGION=us-west-2
# Bucket S3 privé pour les photos. Vide = photos stockées en local (dossier uploads/)
S3_BUCKET=
# Modèle Bedrock (profil d'inférence). Vide = assistant en mode mots-clés (plan B)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
